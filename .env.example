# Copy to .env for local development
# Never commit real keys.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: enable staff role signup (director/secretariat/admin) behind a setup code.
# Set this to a long random string and share it only with trusted staff.
VITE_STAFF_SIGNUP_CODE=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: bootstrap the first admin accounts by email (comma separated).
# Useful if your database doesn't have seed data/triggers yet.
VITE_BOOTSTRAP_ADMIN_EMAILS=admin@example.com
